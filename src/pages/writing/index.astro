---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import ProjectRow from "../../components/ProjectRow.astro";

const writing = (await getCollection("writing")).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Writing" description="Writing on how to tell whether AI agents work: evals, adoption, and ROI.">
  <div class="text">
    <h1 class="case-h">Writing</h1>
    <p class="lede">Short pieces on how to tell whether an AI agent works, drawn from what I build and measure. Each one is also shared on LinkedIn.</p>
  </div>
  <h2 class="lbl">Posts</h2>
  {writing.map((p) => <ProjectRow title={p.data.title} summary={p.data.summary} soon={!p.data.published} />)}
</Base>
